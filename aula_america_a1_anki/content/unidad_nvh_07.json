        ],
        "learning_group": "02_规则理解",
        "learning_order": 780030,
        "category": "U7 核心辨析",
        "question_zh": "酒店里 para tres noches、por noche、por persona 分别在表达什么？",
        "core_answer_zh": "para + 时段表示这次预订/用途；por + 单位表示“每……”。",
        "example_es": "Quería una habitación para tres noches. Cuesta 180 dólares por noche y 25 por persona.",
        "explanation_zh": "`para tres noches` 聚焦“这次住三晚”；`por noche / por persona` 是按单位计价。不要把它扩成一次背完 por/para 的所有规则。",
        "english_comparison": "English: for three nights vs per night / per person.",
        "japanese_comparison": "",
        "negative_transfer": "",
        "note": ""
      },
      {
        "uid": "NVH-U7-R1-L04-R001",
        "unit": "NVH-U7",
        "lesson": "L04",
        "tags": [
          "nvh_u7",
          "u7_r1",
          "nvh::u07::l04",
          "group::02_规则理解",
          "u7_phase1"
        ],
        "learning_group": "02_规则理解",
        "learning_order": 780031,
        "category": "U7 核心辨析",
        "question_zh": "traer 和 llevar 在“带东西”时最实用的区别是什么？",
        "core_answer_zh": "traer = 带到这里来；llevar = 带着/带到那里去。",
        "example_es": "Traigo mi pasaporte. Llevo mi pasaporte al consulado.",
        "explanation_zh": "先抓方向感。llevar 还可表示穿戴、包含等，但这里不要求一次背完所有义项。",
        "english_comparison": "bring vs take/carry",
        "japanese_comparison": "",
        "negative_transfer": "把两个词都只翻成“带”，会丢掉方向信息。",
        "note": ""
      },
      {
        "uid": "NVH-U7-R1-L04-R002",
        "unit": "NVH-U7",
        "lesson": "L04",
        "tags": [
          "nvh_u7",
          "u7_r1",
          "nvh::u07::l04",
          "group::02_规则理解",
          "u7_phase1"
        ],
        "learning_group": "02_规则理解",
        "learning_order": 780032,
        "category": "U7 核心辨析",
        "question_zh": "bueno/a 和 bien 的核心区别是什么？",
        "core_answer_zh": "bueno/a 是形容词，修饰名词；bien 是副词，修饰动作。",
        "example_es": "una buena comida; Cocina bien.",
        "explanation_zh": "说“一顿好饭”要用形容词 buena；说“做饭做得好”才用 bien。",
        "english_comparison": "good vs well",
        "japanese_comparison": "",
        "negative_transfer": "中文都可能只说“好”，容易把 bien 放到名词后。",
        "note": ""
      },
      {
        "uid": "NVH-U7-R1-L03-R001",
        "unit": "NVH-U7",
        "lesson": "L03",
        "tags": [
          "nvh_u7",
